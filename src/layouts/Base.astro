---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description, image, type, pubDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} pubDate={pubDate} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      /* Image slider — enhances <div class="image-slider" data-slider> blocks
         inserted from the CMS body composer ("Image Slider" block). */
      (function () {
        function init() {
          document.querySelectorAll('.image-slider[data-slider]:not([data-ready])').forEach(function (el) {
            var imgs = Array.prototype.slice.call(el.querySelectorAll(':scope > img'));
            if (!imgs.length) return;
            el.setAttribute('data-ready', '1');

            var viewport = document.createElement('div');
            viewport.className = 'slider-viewport';
            var track = document.createElement('div');
            track.className = 'slider-track';

            var slides = imgs.map(function (img) {
              var fig = document.createElement('figure');
              fig.className = 'slide';
              fig.appendChild(img);
              track.appendChild(fig);
              return { caption: img.getAttribute('data-caption') || '' };
            });
            viewport.appendChild(track);
            el.insertBefore(viewport, el.firstChild);

            var prev = document.createElement('button');
            prev.className = 'slider-prev';
            prev.type = 'button';
            prev.setAttribute('aria-label', 'Previous photo');
            prev.textContent = '‹';

            var next = document.createElement('button');
            next.className = 'slider-next';
            next.type = 'button';
            next.setAttribute('aria-label', 'Next photo');
            next.textContent = '›';

            var dots = document.createElement('div');
            dots.className = 'slider-dots';
            dots.setAttribute('role', 'tablist');

            var captionEl = document.createElement('p');
            captionEl.className = 'slider-caption';

            var idx = 0;
            function go(n) {
              idx = Math.max(0, Math.min(slides.length - 1, n));
              track.style.transform = 'translateX(-' + idx * 100 + '%)';
              Array.prototype.forEach.call(dots.children, function (d, i) {
                d.classList.toggle('active', i === idx);
                d.setAttribute('aria-selected', i === idx ? 'true' : 'false');
              });
              prev.disabled = idx === 0;
              next.disabled = idx === slides.length - 1;
              captionEl.textContent = slides[idx].caption;
              captionEl.hidden = !slides[idx].caption;
            }

            prev.addEventListener('click', function () { go(idx - 1); });
            next.addEventListener('click', function () { go(idx + 1); });
            slides.forEach(function (_, i) {
              var d = document.createElement('button');
              d.type = 'button';
              d.setAttribute('role', 'tab');
              d.setAttribute('aria-label', 'Go to photo ' + (i + 1));
              d.addEventListener('click', function () { go(i); });
              dots.appendChild(d);
            });

            var startX = null;
            viewport.addEventListener('touchstart', function (e) {
              startX = e.touches[0].clientX;
            }, { passive: true });
            viewport.addEventListener('touchend', function (e) {
              if (startX === null) return;
              var dx = e.changedTouches[0].clientX - startX;
              if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
              startX = null;
            }, { passive: true });

            el.appendChild(prev);
            el.appendChild(next);
            el.appendChild(dots);
            el.appendChild(captionEl);

            if (slides.length < 2) {
              prev.hidden = true;
              next.hidden = true;
              dots.hidden = true;
            }
            go(0);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
