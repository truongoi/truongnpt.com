---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: i > 0 ? posts[i - 1] : null,
      next: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
  pubDate={post.data.pubDate}
>
  <article class="wrap wrap-narrow">
    <header class="article-head">
      <div class="meta">
        <span class="badge badge-green">{date}</span>
        {post.data.tags.map((t) => <span class="badge">{t}</span>)}
      </div>
      <h1>{post.data.title}</h1>
    </header>

    {post.data.heroImage && (
      <figure class="hero-image">
        <img src={post.data.heroImage} alt={post.data.title} />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <section class="comments" id="comments" data-slug={post.id}>
      <h2>Comments <span class="comments-count"></span></h2>
      <div class="comments-list"><p class="comments-loading">Loading…</p></div>
      <form class="comment-form">
        <h3>Leave a comment</h3>
        <label class="field">Name
          <input name="name" required maxlength="60" autocomplete="name" />
        </label>
        <label class="field hp" aria-hidden="true">Website
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <label class="field">Comment
          <textarea name="body" required maxlength="2000" rows="4"></textarea>
        </label>
        <button class="btn" type="submit">Post comment</button>
        <p class="form-note">Comments are moderated — yours will appear after approval.</p>
        <p class="form-msg" hidden></p>
      </form>
    </section>
    <script is:inline>
      (function () {
        var sec = document.getElementById('comments');
        if (!sec) return;
        var slug = sec.dataset.slug;
        var list = sec.querySelector('.comments-list');
        function mod(action, id) {
          fetch('/api/comments', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: action, id: id }),
          }).then(function () { load(); });
        }
        function render(comments, isAdmin) {
          list.innerHTML = '';
          var count = sec.querySelector('.comments-count');
          if (count) count.textContent = '(' + comments.length + ')';
          if (!comments.length) {
            list.innerHTML = '<p class="no-comments">No comments yet — be the first.</p>';
            return;
          }
          comments.forEach(function (c) {
            var pending = c.approved === 0;
            var div = document.createElement('div');
            div.className = 'comment' + (pending ? ' pending' : '');
            var head = document.createElement('div');
            head.className = 'comment-head';
            var name = document.createElement('strong');
            name.textContent = c.name;
            head.appendChild(name);
            if (pending) {
              var badge = document.createElement('span');
              badge.className = 'pending-badge';
              badge.textContent = 'pending';
              head.appendChild(badge);
            }
            var date = document.createElement('span');
            date.className = 'comment-date';
            date.textContent = new Date(c.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            head.appendChild(date);
            if (isAdmin) {
              var tools = document.createElement('span');
              tools.className = 'comment-tools';
              if (pending) {
                var ok = document.createElement('button');
                ok.type = 'button';
                ok.className = 'comment-tool approve';
                ok.textContent = '✓';
                ok.title = 'Approve';
                ok.setAttribute('aria-label', 'Approve comment');
                ok.addEventListener('click', function () { mod('approve', c.id); });
                tools.appendChild(ok);
              }
              var del = document.createElement('button');
              del.type = 'button';
              del.className = 'comment-tool delete';
              del.textContent = '×';
              del.title = 'Delete';
              del.setAttribute('aria-label', 'Delete comment');
              del.addEventListener('click', function () {
                if (window.confirm('Delete this comment?')) mod('delete', c.id);
              });
              tools.appendChild(del);
              head.appendChild(tools);
            }
            var body = document.createElement('p');
            body.textContent = c.body;
            div.appendChild(head);
            div.appendChild(body);
            list.appendChild(div);
          });
        }
        function load() {
          fetch('/api/comments?slug=' + encodeURIComponent(slug))
            .then(function (r) { return r.json(); })
            .then(function (d) { render(d.comments || [], !!d.admin); })
            .catch(function () { list.innerHTML = '<p class="no-comments">Could not load comments.</p>'; });
        }
        load();
        var form = sec.querySelector('.comment-form');
        var msg = sec.querySelector('.form-msg');
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          msg.hidden = true;
          var fd = new FormData(form);
          fetch('/api/comments', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug: slug, name: fd.get('name'), body: fd.get('body'), website: fd.get('website') }),
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
              if (res.ok) {
                form.reset();
                msg.textContent = 'Thanks! Your comment is awaiting moderation.';
              } else {
                msg.textContent = res.d.error || 'Something went wrong.';
              }
              msg.hidden = false;
            })
            .catch(function () { msg.textContent = 'Something went wrong.'; msg.hidden = false; });
        });
      })();
    </script>

    <nav class="post-nav" aria-label="More posts">
      {prev ? (
        <a class="nb-card nb-card-hover" href={`/p/${prev.id}/`}>
          <span class="label">← Newer</span>
          <span class="title">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="nb-card nb-card-hover next" href={`/p/${next.id}/`}>
          <span class="label">Older →</span>
          <span class="title">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>

    <div style="text-align: center; margin: 2.5rem 0 1rem;">
      <a class="btn" href="/blog/">← Back to all posts</a>
    </div>
  </article>
</Base>
