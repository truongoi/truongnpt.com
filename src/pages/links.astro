---
import Bare from '../layouts/Bare.astro';
import data from '../profile-links.json';

const links = data.links;
---

<Bare
  title="Profile links"
  description="All of Truong Nguyen's links in one place."
>
  <section class="page-hero" style="text-align: center;">
    <div class="wrap wrap-narrow">
      <img
        src={data.avatar}
        alt={data.name}
        width="120"
        height="120"
        style="border: 3px solid var(--ink); border-radius: 50%; box-shadow: var(--shadow-sm); margin-bottom: 1rem;"
      />
      <h1 style="margin-bottom: 0.3rem;">{data.name}</h1>
      <p class="lede" style="margin: 0 auto;">{data.tagline}</p>
    </div>
  </section>

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap wrap-narrow" style="max-width: 520px; display: flex; flex-direction: column; gap: 1rem;">
      {links.map((l) => (
        <a
          class={`btn ${l.color}`}
          href={l.href}
          target={l.href.startsWith('http') ? '_blank' : undefined}
          rel={l.href.startsWith('http') ? 'noopener' : undefined}
          style="justify-content: flex-start; padding: 1em 1.4em; font-size: 1.05rem;"
        >
          <span style="font-size: 1.3em;">{l.badge}</span>
          <span>{l.label}</span>
          <span style="margin-left: auto; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; opacity: 0.75;">{l.sub}</span>
        </a>
      ))}
    </div>
  </section>
</Bare>
