---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import settings from '../site-settings.json';
const siteConfig = { showProjects: settings.showProjects ?? true };

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Base
  title={`${settings.siteTitle} — Front-End Engineer on Code, Travel, Life`}
  description={settings.siteDescription}
  image="/images/og-image.jpg"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="hero-eyebrow">
          <span class="badge badge-blue">{settings.heroEyebrow}</span>
        </div>
        <h1>{settings.heroName} <span class="highlight">{settings.heroNameHighlight}</span></h1>
        <p class="lead">
          {settings.heroLead}
        </p>
      </div>
      <figure class="avatar-card">
        <img src={settings.heroImage} alt={settings.heroName} width="800" height="800" />
        <figcaption>{settings.heroCaption}</figcaption>
      </figure>
      <div class="hero-cta">
        <a class="btn btn-green" href={settings.heroCtaPrimaryHref}>{settings.heroCtaPrimaryLabel}</a>
        <a class="btn" href={settings.heroCtaSecondaryHref}>{settings.heroCtaSecondaryLabel}</a>
      </div>
    </div>
  </section>

  {siteConfig.showProjects && projects.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2><span class="tick"></span>Projects</h2>
          <a class="btn btn-sm" href="/projects/">All projects →</a>
        </div>
        <div class="project-grid">
          {projects.map((p) => (
            <a class="nb-card nb-card-hover post-card" href={`/prj/${p.id}/`}>
              {p.data.heroImage && (
                <div class="thumb">
                  <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <div class="meta">
                  <span class="badge badge-blue">Project</span>
                </div>
                <h3>{p.data.title}</h3>
                <p class="excerpt">{p.data.description}</p>
                <span class="read-more">View <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap wrap-narrow">
      <div class="nb-card" style="text-align: center; padding: 1.4rem 1.2rem;">
        <h2 style="margin-bottom: 0.5em;">{settings.ctaTitle}</h2>
        <p style="color: var(--muted); margin-bottom: 0.9rem;">
          {settings.ctaText}
        </p>
        <a class="btn btn-blue" href={settings.ctaButtonHref}>{settings.ctaButtonLabel}</a>
      </div>
    </div>
  </section>
</Base>
