---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Base
  title="truongnguyen.io"
  description="Personal blog of Truong Nguyen — front-end engineer. Thoughts on code, travel, photography and life."
  image="/images/og-image.jpg"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="hero-eyebrow">
          <span class="badge badge-blue">👋 Hello, I'm</span>
        </div>
        <h1>Truong <span class="highlight">Nguyen</span></h1>
        <p class="lead">
          Front-end engineer, ex-Ogilvy Vietnam. I write about code, travel,
          photography and life — in English and Vietnamese.
        </p>
        <div class="hero-cta">
          <a class="btn btn-green" href="/blog/">Read the blog →</a>
          <a class="btn" href="/about/">About me</a>
        </div>
      </div>
      <figure class="avatar-card">
        <img src="/images/avatar@2x.png" alt="Truong Nguyen" width="680" height="680" />
        <figcaption>that's me ✌️</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2><span class="tick"></span>Latest posts</h2>
        <a class="btn btn-sm" href="/blog/">All posts →</a>
      </div>
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2><span class="tick"></span>Projects</h2>
          <a class="btn btn-sm" href="/projects/">All projects →</a>
        </div>
        <div class="project-grid">
          {projects.map((p) => (
            <a class="nb-card nb-card-hover post-card" href={`/prj/${p.id}/`}>
              {p.data.heroImage && (
                <div class="thumb">
                  <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <div class="meta">
                  <span class="badge badge-blue">Project</span>
                </div>
                <h3>{p.data.title}</h3>
                <p class="excerpt">{p.data.description}</p>
                <span class="read-more">View <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap wrap-narrow">
      <div class="nb-card" style="text-align: center; padding: 2.5rem 2rem;">
        <h2 style="margin-bottom: 0.5em;">Say hello 👋</h2>
        <p style="color: var(--muted); margin-bottom: 1.5rem;">
          Questions, collabs, or just want to chat? My inbox is open.
        </p>
        <a class="btn btn-blue" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
