---
import settings from '../site-settings.json';
const siteConfig = { showProjects: settings.showProjects ?? true };
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  ...(siteConfig.showProjects ? [{ href: '/projects/', label: 'Projects' }] : []),
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${settings.logoText} home`}>
      <span class="logo-mark">{settings.logoMark}</span>
      <span class="logo-text">{settings.logoText}</span>
    </a>
    <nav class="nav" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
