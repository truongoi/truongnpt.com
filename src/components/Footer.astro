---
import settings from '../site-settings.json';

const siteConfig = { showProjects: settings.showProjects ?? true };
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div>
      <h4>{settings.logoText}</h4>
      <p>
        {settings.footerAbout}
      </p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="/blog/">Blog</a></li>
        {siteConfig.showProjects && <li><a href="/projects/">Projects</a></li>}
        {settings.footerExploreLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Elsewhere</h4>
      <ul>
        {settings.footerSocialLinks.map((l) => (
          <li><a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap">
      <span>© {year} {settings.heroName} {settings.heroNameHighlight}</span>
      <span>Built with Astro · <a href="/privacy-policy/">Privacy</a></span>
    </div>
  </div>
</footer>
